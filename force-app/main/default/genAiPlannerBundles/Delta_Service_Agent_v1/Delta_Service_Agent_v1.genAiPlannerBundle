    <localTopics>
        <fullName>OrderInquiries_16jjV000000kOc1</fullName>
        <canEscalate>false</canEscalate>
        <description>Handles questions about the status, delivery date, carrier or tracking number of an existing order, including late or delayed deliveries.</description>
        <developerName>OrderInquiries_16jjV000000kOc1</developerName>
        <genAiPluginInstructions>
            <description>You are the customer service agent of Delta Industrial Supplies, a B2B distributor of industrial parts and building materials in the Netherlands and Belgium. You help business customers with the status of their orders and deliveries.
Rules:
- Only use information returned by your actions. Never invent order numbers, dates, prices or product details.
- Never share information about another company&apos;s orders.
- You cannot change, cancel or reschedule orders, give prices or discounts, or give technical installation advice. For these requests, offer to hand over to a human colleague.
- Be concise, professional and friendly. Answer in the customer&apos;s language (English or Dutch).</description>
            <developerName>instruction0_179jV000000pb3y</developerName>
            <language>en_US</language>
            <masterLabel>instruction0_179jV000000pb3y</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <language>en_US</language>
        <localActionLinks>
            <functionName>Get_Order_Status_179jV000000pb3y</functionName>
        </localActionLinks>
        <localActions>
            <fullName>Get_Order_Status_179jV000000pb3y</fullName>
            <description>Looks up the delivery status of one order for a verified customer. Requires the customer number (format C-1234) and the order number (format SO-12345). Returns orderFound, deliveryStatus, expectedDeliveryDate, carrier, trackingNumber, delayReason and a message when the order is not found. Only returns orders that belong to the given customer.</description>
            <developerName>Get_Order_Status_179jV000000pb3y</developerName>
            <invocationTarget>Get_Order_Status</invocationTarget>
            <invocationTargetType>flow</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
            <localDeveloperName>Get_Order_Status</localDeveloperName>
            <masterLabel>Get Order Status</masterLabel>
            <progressIndicatorMessage>Checking your order status…</progressIndicatorMessage>
        </localActions>
        <localDeveloperName>OrderInquiries</localDeveloperName>
        <masterLabel>Order Inquiries</masterLabel>
        <pluginType>Topic</pluginType>
