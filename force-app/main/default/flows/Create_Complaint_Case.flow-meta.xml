    <constants>
        <description>Message returned when Create Case or Get Created Case fails.</description>
        <name>createFailedMessage</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Something went wrong while registering your complaint. Please try again later, or I can connect you with a colleague.</stringValue>
        </value>
    </constants>
    <constants>
        <description>Message returned when the customer number does not exist and no order number was given.</description>
        <name>customerNotFoundMessage</name>
        <dataType>String</dataType>
        <value>
            <stringValue>I couldn&apos;t find a customer with this customer number. Please check it.</stringValue>
        </value>
    </constants>
    <constants>
        <description>Message returned when the customer number or the complaint description is blank.</description>
        <name>missingInputMessage</name>
        <dataType>String</dataType>
        <value>
            <stringValue>I need your customer number and a short description of the problem to register a complaint.</stringValue>
        </value>
    </constants>
    <constants>
        <description>Identical to the not-found message of Get_Order_Status, so the caller cannot tell an unknown customer from another company&apos;s order.</description>
        <name>notFoundMessage</name>
        <dataType>String</dataType>
        <value>
            <stringValue>No order found for this customer number and order number. Please check both numbers.</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Account_Found</name>
        <label>Account Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Order_Number_Given_Unknown_Customer</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Order_Number_Provided</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Guardrail: continue only if the customer number and the complaint are filled. A blank value in a Get Records filter would match records where that field is empty.</description>
        <name>Inputs_Provided</name>
        <label>Inputs Provided?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Missing_Input</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Inputs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>customerNumber</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>complaintSummary</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Duplicate protection: is there already an open case from the agent for this order?</description>
        <name>Open_Case_Found</name>
        <label>Open Case Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Related_Order</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Open_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Case</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
