    <description>Registers a customer&apos;s quote request as an Opportunity for sales: one product (found with the subflow Get_Product_Specs) and a whole quantity, for the given customer number. No price, amount or opportunity products: sales prepares the quote. Never creates a second open agent request for the same account and product. Used by the service agent (UC3).</description>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <description>Close date: today + 30 days.</description>
        <name>closeDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 30</expression>
    </formulas>
    <formulas>
        <name>duplicateMessage</name>
        <dataType>String</dataType>
        <expression>&quot;There is already an open quote request &quot; &amp; {!Get_Open_Quote.Quote_Request_Number__c} &amp; &quot; for &quot; &amp; {!Get_Product.Name} &amp; &quot;. A sales colleague will contact you.&quot;</expression>
    </formulas>
    <formulas>
        <description>Customer note, cut to the 255 characters of Customer_Note__c (a long note never blocks a quote request).</description>
        <name>noteText</name>
        <dataType>String</dataType>
        <expression>LEFT({!customerNote}, 255)</expression>
    </formulas>
    <formulas>
        <description>Opportunity name, cut to the 120 characters of Opportunity.Name.</description>
        <name>opportunityName</name>
        <dataType>String</dataType>
        <expression>LEFT(&quot;Quote request - &quot; &amp; {!Get_Product.ProductCode} &amp; &quot; x &quot; &amp; TEXT({!quantityWhole}) &amp; &quot; - &quot; &amp; {!Get_Account.Name}, 120)</expression>
    </formulas>
    <formulas>
        <description>True if the quantity is a whole number from 1 to 10,000.</description>
        <name>quantityValid</name>
        <dataType>Boolean</dataType>
        <expression>AND({!quantity} &gt;= 1, {!quantity} &lt;= 10000, {!quantity} = ROUND({!quantity}, 0))</expression>
    </formulas>
    <formulas>
        <description>The validated quantity as a whole number (no decimals in names, messages or the quantity field).</description>
        <name>quantityWhole</name>
        <dataType>Number</dataType>
        <expression>ROUND({!quantity}, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Same format as the existing quote requests, e.g. &quot;40x Ball Valve Stainless DN25&quot;.</description>
        <name>requestedItems</name>
        <dataType>String</dataType>
        <expression>TEXT({!quantityWhole}) &amp; &quot;x &quot; &amp; {!Get_Product.Name}</expression>
    </formulas>
    <formulas>
        <name>successMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Your quote request &quot; &amp; {!Get_Created_Quote.Quote_Request_Number__c} &amp; &quot; for &quot; &amp; TEXT({!quantityWhole}) &amp; &quot; x &quot; &amp; {!Get_Product.Name} &amp; &quot; has been registered. A sales colleague will contact you with a quote.&quot;</expression>
    </formulas>
