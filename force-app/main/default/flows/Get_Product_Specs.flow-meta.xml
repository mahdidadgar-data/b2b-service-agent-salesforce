    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Pre-filter: active products whose name, product code or search keywords contain the longest word stem (the shorter stem, so plurals are found too). Every word is then checked in Loop Words. Reads only the spec fields plus Search_Keywords__c, which is used for matching only.</description>
        <name>Get_Word_Candidates</name>
        <label>Get Word Candidates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Candidates</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4)</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <elementReference>longestWord</elementReference>
            </value>
        </filters>
        <filters>
            <field>ProductCode</field>
            <operator>Contains</operator>
            <value>
                <elementReference>longestWord</elementReference>
            </value>
        </filters>
        <filters>
            <field>Search_Keywords__c</field>
            <operator>Contains</operator>
            <value>
                <elementReference>longestWord</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Product2</object>
        <outputReference>wordCandidates</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>ProductCode</queriedFields>
        <queriedFields>Category__c</queriedFields>
        <queriedFields>Max_Pressure_bar__c</queriedFields>
        <queriedFields>Min_Temperature_C__c</queriedFields>
        <queriedFields>Max_Temperature_C__c</queriedFields>
        <queriedFields>Connection_Size__c</queriedFields>
        <queriedFields>Material__c</queriedFields>
        <queriedFields>Datasheet_Text__c</queriedFields>
        <queriedFields>Search_Keywords__c</queriedFields>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>
    <recordLookups>
        <description>Active products whose product code or name is exactly the search term. Reads only the spec fields.</description>
        <name>Get_Exact_Matches</name>
        <label>Get Exact Matches</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Exact_Matches</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ProductCode</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>searchTerm</elementReference>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>searchTerm</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Product2</object>
        <outputReference>exactMatches</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>ProductCode</queriedFields>
        <queriedFields>Category__c</queriedFields>
        <queriedFields>Max_Pressure_bar__c</queriedFields>
        <queriedFields>Min_Temperature_C__c</queriedFields>
        <queriedFields>Max_Temperature_C__c</queriedFields>
        <queriedFields>Connection_Size__c</queriedFields>
        <queriedFields>Material__c</queriedFields>
        <queriedFields>Datasheet_Text__c</queriedFields>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>
