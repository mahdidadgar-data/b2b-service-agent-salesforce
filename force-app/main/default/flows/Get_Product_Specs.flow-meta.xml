        <name>Loop_Select</name>
        <label>Loop Select</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentProduct</assignNextValueToReference>
        <collectionReference>candidates</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Selected</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Product_Output</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Checks every word of the search term against the current candidate.</description>
        <name>Loop_Words</name>
        <label>Loop Words</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>checkWord</assignNextValueToReference>
        <collectionReference>words</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Word_In_Product</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>All_Words_Found</targetReference>
        </noMoreValuesConnector>
    </loops>
