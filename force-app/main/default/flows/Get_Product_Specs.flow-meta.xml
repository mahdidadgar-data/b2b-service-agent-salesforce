<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Adds one product name to the list of matches shown to the customer.</description>
        <name>Add_To_List</name>
        <label>Add To List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>matchingProducts</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>nextMatchingProducts</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>listedCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_List_Matches</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>A candidate that contains every word is a match.</description>
        <name>Add_Word_Match</name>
        <label>Add Word Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>wordMatches</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>currentProduct</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Candidates</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_Word_Matches</name>
        <label>Count Word Matches</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>matchCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>wordMatches</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Word_Match_Result</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_Exact_Matches</name>
        <label>Count Exact Matches</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>exactCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>exactMatches</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Exactly_One_Exact</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Takes the first word off the remaining text and remembers its stem (plural tolerance, see nextWordStem). TRIM in restText skips the empty parts of double spaces. currentWord is assigned first, while remainingText still holds the word.</description>
        <name>Extract_Word</name>
        <label>Extract Word</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>currentWord</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>nextWordStem</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>remainingText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>restText</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>words</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>currentWord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Longest_Word</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Each candidate starts as a match until a word is missing.</description>
        <name>Reset_Word_Check</name>
        <label>Reset Word Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>allWordsFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Words</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Candidates_Word</name>
        <label>Set Candidates (Word Match)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>candidates</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>wordMatches</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Select</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Candidates_Exact</name>
        <label>Set Candidates (Exact)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>candidates</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>exactMatches</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Select</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Guardrail: a blank or too short search term never reaches the record lookups (a short Contains filter would match almost everything).</description>
        <name>Set_Missing_Input</name>
        <label>Set Missing Input</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>productFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>message</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>missingInputMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Not_Found</name>
        <label>Set Not Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>productFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>message</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>notFoundMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Copies the specifications of the one matching product to the outputs. Only these fields leave the flow: no price, stock or other data.</description>
        <name>Set_Product_Output</name>
        <label>Set Product Output</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>productFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>matchCount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>productName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>selectedProduct.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>productCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>selectedProduct.ProductCode</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>category</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>selectedProduct.Category__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>maxPressureBar</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>maxPressureText</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>minTemperatureC</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>minTemperatureText</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>maxTemperatureC</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>maxTemperatureText</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>connectionSize</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>selectedProduct.Connection_Size__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>material</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>selectedProduct.Material__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>datasheetText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>selectedProduct.Datasheet_Text__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>The longest word is used for the database pre-filter: it narrows the candidates the most.</description>
        <name>Set_Longest_Word</name>
        <label>Set Longest Word</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>longestWord</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>currentWord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Has_Remaining_Words</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Starts splitting the trimmed search term into words.</description>
        <name>Set_Remaining_Text</name>
        <label>Set Remaining Text</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>remainingText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>searchTerm</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Has_Remaining_Words</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Selected</name>
        <label>Set Selected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>selectedProduct</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>currentProduct</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Select</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Several_Matches</name>
        <label>Set Several Matches</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>productFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>message</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>severalMatchesMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Word_Missing</name>
        <label>Set Word Missing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>allWordsFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Words</targetReference>
        </connector>
    </assignments>
    <constants>
        <description>Message returned when the search term is blank or shorter than 3 characters.</description>
        <name>missingInputMessage</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Please give me the product name or product code.</stringValue>
        </value>
    </constants>
    <constants>
        <description>Message returned when no active product matches.</description>
        <name>notFoundMessage</name>
        <dataType>String</dataType>
        <value>
            <stringValue>I couldn&apos;t find a product matching that name or code. Please check it.</stringValue>
        </value>
    </constants>
    <constants>
        <description>Message returned when more than one active product matches.</description>
        <name>severalMatchesMessage</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Several products match. Please tell me which one you mean.</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Lists at most 10 product names.</description>
        <name>Below_List_Limit</name>
        <label>Below List Limit?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_List_Matches</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Below_Limit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>listedCount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>10.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_To_List</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>After all words were checked: keep the candidate only if every word was found.</description>
        <name>All_Words_Found</name>
        <label>All Words Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Candidates</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_All_Words</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>allWordsFound</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Word_Match</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Remaining_Words</name>
        <label>Has Remaining Words?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Word_Candidates</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Remaining</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>remainingText</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Extract_Word</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Longest_Word</name>
        <label>Is Longest Word?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Has_Remaining_Words</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Longest</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isLongerWord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Longest_Word</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>0, 1 or several products contain every word.</description>
        <name>Word_Match_Result</name>
        <label>Word Match Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_List_Matches</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Several</defaultConnectorLabel>
        <rules>
            <name>No_Matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>matchCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Not_Found</targetReference>
            </connector>
            <label>None</label>
        </rules>
        <rules>
            <name>One_Match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>matchCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Candidates_Word</targetReference>
            </connector>
            <label>One</label>
        </rules>
    </decisions>
    <decisions>
        <description>Literal, case-insensitive check of one word against the product name and code. Also re-checks the pre-filter word, so the result never depends on how the database filter treats % or _.</description>
        <name>Word_In_Product</name>
        <label>Word In Product?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Word_Missing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Word_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>wordInProduct</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Words</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>An exact product code or name wins, but only if it identifies exactly one product.</description>
        <name>Exactly_One_Exact</name>
        <label>Exactly One Exact Match?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Remaining_Text</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_One_Exact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>exactCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Candidates_Exact</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Guardrail: continue only if the trimmed search term has at least 3 characters.</description>
        <name>Search_Term_Valid</name>
        <label>Search Term Valid?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Missing_Input</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>searchTermValid</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Exact_Matches</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Returns the specifications of one active product, found by exact product code or name, or by words in any order (every word, or its stem without a plural ending, must appear in the name, code or search keywords; the keywords hold Dutch/English synonyms and irregular plurals and are never returned). When several products match, returns up to 10 names so the customer can choose. Never returns prices or stock. Used by the service agent (UC2).</description>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <description>Max pressure as text; empty when the field is empty, never 0.</description>
        <name>maxPressureText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!selectedProduct.Max_Pressure_bar__c}), &quot;&quot;, TEXT({!selectedProduct.Max_Pressure_bar__c}))</expression>
    </formulas>
    <formulas>
        <description>Max temperature as text; empty when the field is empty, never 0.</description>
        <name>maxTemperatureText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!selectedProduct.Max_Temperature_C__c}), &quot;&quot;, TEXT({!selectedProduct.Max_Temperature_C__c}))</expression>
    </formulas>
    <formulas>
        <description>Min temperature as text; empty when the field is empty, never 0.</description>
        <name>minTemperatureText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!selectedProduct.Min_Temperature_C__c}), &quot;&quot;, TEXT({!selectedProduct.Min_Temperature_C__c}))</expression>
    </formulas>
    <formulas>
        <description>The list of matching product names with the current product added, separated by &quot;; &quot;.</description>
        <name>nextMatchingProducts</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!matchingProducts}), {!currentProduct.Name}, {!matchingProducts} &amp; &quot;; &quot; &amp; {!currentProduct.Name})</expression>
    </formulas>
    <formulas>
        <description>The search term without leading and trailing spaces; used in both lookups.</description>
        <name>searchTerm</name>
        <dataType>String</dataType>
        <expression>TRIM({!productSearch})</expression>
    </formulas>
    <formulas>
        <description>True if the trimmed search term has at least 3 characters.</description>
        <name>searchTermValid</name>
        <dataType>Boolean</dataType>
        <expression>LEN(TRIM({!productSearch})) &gt;= 3</expression>
    </formulas>
    <formulas>
        <description>True if the current word is longer than the longest word so far (the first longest word wins a tie).</description>
        <name>isLongerWord</name>
        <dataType>Boolean</dataType>
        <expression>LEN({!currentWord}) &gt; LEN(BLANKVALUE({!longestWord}, &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <description>The first word of the remaining text.</description>
        <name>nextWord</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!remainingText}, &quot; &quot;), LEFT({!remainingText}, FIND(&quot; &quot;, {!remainingText}) - 1), {!remainingText})</expression>
    </formulas>
    <formulas>
        <description>Plural tolerance: the first word without a plural ending. 6+ characters ending in &quot;en&quot; or &quot;es&quot; lose those 2 letters (pompen -&gt; pomp, valves -&gt; valv); otherwise 5+ characters ending in &quot;s&quot; lose the s (pumps -&gt; pump). The stem is always at least 4 characters and always a prefix of the word, so matching the stem = matching the word OR its stem; every word must still match. Short words (rvs, DN25, DIS-) are never stemmed. Irregular plurals (kranen, kleppen) are in the search keywords.</description>
        <name>nextWordStem</name>
        <dataType>String</dataType>
        <expression>IF(AND(LEN({!nextWord}) &gt;= 6, OR(RIGHT(LOWER({!nextWord}), 2) = &quot;en&quot;, RIGHT(LOWER({!nextWord}), 2) = &quot;es&quot;)), LEFT({!nextWord}, LEN({!nextWord}) - 2), IF(AND(LEN({!nextWord}) &gt;= 5, RIGHT(LOWER({!nextWord}), 1) = &quot;s&quot;), LEFT({!nextWord}, LEN({!nextWord}) - 1), {!nextWord}))</expression>
    </formulas>
    <formulas>
        <description>The remaining text after the first word, trimmed (so double spaces never produce an empty word).</description>
        <name>restText</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!remainingText}, &quot; &quot;), TRIM(MID({!remainingText}, FIND(&quot; &quot;, {!remainingText}) + 1, LEN({!remainingText}))), &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <description>True if the word appears in the product name, product code or search keywords: case-insensitive, literal text (no wildcards). The keywords are used for matching only and never become an output.</description>
        <name>wordInProduct</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(LOWER({!currentProduct.Name} &amp; &quot; &quot; &amp; BLANKVALUE({!currentProduct.ProductCode}, &quot;&quot;) &amp; &quot; &quot; &amp; BLANKVALUE({!currentProduct.Search_Keywords__c}, &quot;&quot;)), LOWER({!checkWord}))</expression>
    </formulas>
    <interviewLabel>Get Product Specs {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Product Specs</label>
    <loops>
        <description>Checks each pre-filtered candidate against every word.</description>
        <name>Loop_Candidates</name>
        <label>Loop Candidates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentProduct</assignNextValueToReference>
        <collectionReference>wordCandidates</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Reset_Word_Check</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Count_Word_Matches</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Lists the names of the matching products (the decision inside keeps it to 10).</description>
        <name>Loop_List_Matches</name>
        <label>Loop List Matches</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentProduct</assignNextValueToReference>
        <collectionReference>wordMatches</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Below_List_Limit</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Several_Matches</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
